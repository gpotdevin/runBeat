<?xml version="1.0" encoding="UTF-8"?>
<!--
  RunBeat data field (Connect IQ / Monkey C).

  A data field runs ONLY during an activity (run, bike, ...) — its lifecycle
  is fully managed by the watch firmware, so it can never run in the
  background or keep the BLE radio awake outside an activity. This is what
  fixes the battery drain of the old audio-content-provider companion app.

  The id below is the registered IQ app UUID. Keep in sync with
  GarminCompanionManager.IQ_APP_ID on the phone side (it registers the same
  id with the Connect IQ Mobile SDK).
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
<iq:application id="06c14376-0c60-4e4c-a977-e93364ace3eb"
                type="datafield"
                name="@Strings.AppName"
                entry="RunBeatDataFieldApp"
                launcherIcon="@Drawables.LauncherIcon">

    <iq:products>
        <!-- Data fields run on all Connect IQ devices that support them.
             No music-capable restriction (unlike the old
             audio-content-provider type): the app only sends messages to
             the phone, never plays audio on the watch. -->
        <iq:product id="fr245"/>
        <iq:product id="fr245m"/>
        <iq:product id="fr255"/>
        <iq:product id="fr255m"/>
        <iq:product id="fr265"/>
        <iq:product id="fr955"/>
        <iq:product id="fr965"/>
        <!-- fenix 7 (all sizes) -->
        <iq:product id="fenix7"/>
        <iq:product id="fenix7s"/>
        <iq:product id="fenix7x"/>
        <!-- fenix 8 (solar 47/51mm, AMOLED 43/47mm) -->
        <iq:product id="fenix8solar47mm"/>
        <iq:product id="fenix8solar51mm"/>
        <iq:product id="fenix843mm"/>
        <iq:product id="fenix847mm"/>
        <!-- epix (Gen 2) -->
        <iq:product id="epix2"/>
        <!-- Venu 2 -->
        <iq:product id="venu2"/>
        <!-- Venu 3 -->
        <iq:product id="venu3"/>
        <iq:product id="venu3s"/>
    </iq:products>

    <iq:permissions>
        <!-- Phone messaging with the RunBeat companion (required). -->
        <iq:uses-permission id="Communications"/>
<!-- NOTE: no Background permission — a data field only runs during
             an activity, the system controls its lifecycle, so it can never
             drain the battery outside a workout. -->
    </iq:permissions>

    <iq:languages>
        <iq:language>eng</iq:language>
    </iq:languages>
</iq:application>
</iq:manifest>
