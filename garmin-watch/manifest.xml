<?xml version="1.0" encoding="UTF-8"?>
<!--
  RunBeat companion watch app (Connect IQ / Monkey C).

  The id below is the final registered IQ app UUID. Keep in sync with
  GarminCompanionManager.IQ_APP_ID on the phone side (it registers the same
  id with the Connect IQ Mobile SDK).
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
<iq:application id="06c14376-0c60-4e4c-a977-e93364ace3eb"
                type="audio-content-provider-app"
                name="@Strings.AppName"
                entry="RunBeatCompanionApp"
                launcherIcon="@Drawables.LauncherIcon">
 
    <iq:products>
        <!-- Forerunner 245 Music / 255 Music / 265 / 955 / 965
             (audio-content-provider apps need on-watch music support:
             the plain fr245/fr255 are NOT valid targets for this type). -->
        <!-- Hybrid launch (2026-10-31): this type is what makes RunBeat
             appear in Music -> Music Providers and reachable from the music
             shortcut, like Spotify. getInitialView() still serves the
             direct app-menu launch; getPlaybackConfigurationView() serves
             the provider flow. In the provider flow the stock Music app is
             the host (brief flash on launch, extra back press) — that is
             firmware behavior, no API can remove it. RunBeat plays no audio
             on the watch; control from the stock player also works via the
             phone's "Phone" media source (MediaSession metadata). -->
        <iq:product id="fr245m"/>
        <iq:product id="fr255m"/>
        <iq:product id="fr265"/>
        <iq:product id="fr955"/>
        <iq:product id="fr965"/>
        <!-- fenix 7 (all sizes) -->
        <iq:product id="fenix7"/>
        <iq:product id="fenix7s"/>
        <iq:product id="fenix7x"/>
        <!-- fenix 8 (solar 47/51mm, AMOLED 43/47mm) -->
        <iq:product id="fenix8solar47mm"/>
        <iq:product id="fenix8solar51mm"/>
        <iq:product id="fenix843mm"/>
        <iq:product id="fenix847mm"/>
        <!-- epix (Gen 2) -->
        <iq:product id="epix2"/>
        <!-- Venu 2 -->
        <iq:product id="venu2"/>
        <!-- Venu 3 -->
        <iq:product id="venu3"/>
        <iq:product id="venu3s"/>
    </iq:products>

    <iq:permissions>
        <!-- Phone messaging with the RunBeat companion (required). -->
        <iq:uses-permission id="Communications"/>
        <!-- Accelerometer-based cadence sampling. -->
        <iq:uses-permission id="Sensor"/>
        <!-- NOTE: no Background permission — the app never runs in the
             background and the phone never wakes it (battery): it connects
             only when the user starts it manually. -->
        <!-- NOTE: no Media permission — music always plays on the phone, the
             watch only sends messages. -->
        <!-- NOTE: no FitContributor — this app is not a data field. -->
    </iq:permissions>

    <iq:languages>
        <iq:language>eng</iq:language>
    </iq:languages>
</iq:application>
</iq:manifest>
