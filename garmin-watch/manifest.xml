<?xml version="1.0" encoding="UTF-8"?>
<!--
  RunBeat companion watch app (Connect IQ / Monkey C).

  The id below is the final registered IQ app UUID. Keep in sync with
  GarminCompanionManager.IQ_APP_ID on the phone side (it registers the same
  id with the Connect IQ Mobile SDK).

  Plain device app (watch-app), NOT an audio-content-provider-app: RunBeat
  is a remote control for playback on the phone, never an on-watch music
  source, so it has no reason to live inside the system music provider flow
  (launching from the provider list starts the stock music app beneath the
  remote and back-exit lands in it). As a watch-app it launches directly
  from the app list / hotkey, back exits to the watch face, System.exit
  works (device apps), and Background.requestApplicationWake is valid for
  its background tasks.
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
<iq:application id="06c14376-0c60-4e4c-a977-e93364ace3eb"
                type="watch-app"
                name="@Strings.AppName"
                entry="RunBeatCompanionApp"
                launcherIcon="@Drawables.LauncherIcon">

    <iq:products>
        <!-- Forerunner 245 Music / 255 Music / 265 / 955 / 965,
             fenix 7/8, epix (Gen 2), Venu 2/3. As a plain watch-app the
             music hardware requirement is gone (nothing plays on the
             watch) — the set is kept to the devices the app was tested
             on; non-music variants can be added without code changes. -->
        <iq:product id="fr245m"/>
        <iq:product id="fr255m"/>
        <iq:product id="fr265"/>
        <iq:product id="fr955"/>
        <iq:product id="fr965"/>
        <!-- fenix 7 (all sizes) -->
        <iq:product id="fenix7"/>
        <iq:product id="fenix7s"/>
        <iq:product id="fenix7x"/>
        <!-- fenix 8 (solar 47/51mm, AMOLED 43/47mm) -->
        <iq:product id="fenix8solar47mm"/>
        <iq:product id="fenix8solar51mm"/>
        <iq:product id="fenix843mm"/>
        <iq:product id="fenix847mm"/>
        <!-- epix (Gen 2) -->
        <iq:product id="epix2"/>
        <!-- Venu 2 -->
        <iq:product id="venu2"/>
        <!-- Venu 3 -->
        <iq:product id="venu3"/>
        <iq:product id="venu3s"/>
    </iq:products>

    <iq:permissions>
        <!-- Phone messaging with the RunBeat companion (required). -->
        <iq:uses-permission id="Communications"/>
        <!-- Accelerometer-based cadence sampling. -->
        <iq:uses-permission id="Sensor"/>
        <!-- Background service: re-activation. registerForPhoneAppMessageEvent
             wakes the app's background process when the phone sends
             {"type":"wake"} (playback started, no watch app open) — the
             background shows the launch dialog without the app running. -->
        <iq:uses-permission id="Background"/>
        <!-- NOTE: no Media permission — music always plays on the phone, the
             watch only sends messages. -->
        <!-- NOTE: no FitContributor — this app is not a data field. -->
    </iq:permissions>

    <iq:languages>
        <iq:language>eng</iq:language>
    </iq:languages>
</iq:application>
</iq:manifest>
