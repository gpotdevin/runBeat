<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-view layouts, square and round variants. Each layout provides the page
  header label (id "headerLabel"); its text and color are set at runtime via
  WatchUi.Text.setText()/setColor() (see source/view/BaseView.mc). All dynamic
  content (source, title, icons, big numbers, rows, ack, page indicator) is
  drawn in onUpdate() relative to the screen size so it adapts to every
  target device (218-454 px, round and square).
-->
<layouts>
    <!-- Main page (transport). The header doubles as the source label. -->
    <layout id="MainLayout">
        <label id="headerLabel" x="center" y="18" font="Graphics.FONT_TINY" color="#AAAAAA" justification="Graphics.TEXT_JUSTIFY_CENTER">@Strings.PhoneNotConnected</label>
    </layout>
    <layout id="MainLayoutRound">
        <label id="headerLabel" x="center" y="34" font="Graphics.FONT_TINY" color="#AAAAAA" justification="Graphics.TEXT_JUSTIFY_CENTER">@Strings.PhoneNotConnected</label>
    </layout>

    <!-- Cadence page. -->
    <layout id="CadenceLayout">
        <label id="headerLabel" x="center" y="18" font="Graphics.FONT_TINY" color="#AAAAAA" justification="Graphics.TEXT_JUSTIFY_CENTER">@Strings.HeaderCadence</label>
    </layout>
    <layout id="CadenceLayoutRound">
        <label id="headerLabel" x="center" y="34" font="Graphics.FONT_TINY" color="#AAAAAA" justification="Graphics.TEXT_JUSTIFY_CENTER">@Strings.HeaderCadence</label>
    </layout>

    <!-- Control page. -->
    <layout id="ControlLayout">
        <label id="headerLabel" x="center" y="18" font="Graphics.FONT_TINY" color="#AAAAAA" justification="Graphics.TEXT_JUSTIFY_CENTER">@Strings.HeaderControls</label>
    </layout>
    <layout id="ControlLayoutRound">
        <label id="headerLabel" x="center" y="34" font="Graphics.FONT_TINY" color="#AAAAAA" justification="Graphics.TEXT_JUSTIFY_CENTER">@Strings.HeaderControls</label>
    </layout>
</layouts>
