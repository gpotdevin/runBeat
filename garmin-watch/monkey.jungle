# Build configuration for the RunBeat companion watch app (Monkey C).
# This project is NOT part of the Android Gradle build. Build it with the
# Garmin Connect IQ SDK (VS Code extension or Eclipse + SDK Manager):
# monkeyc compile + package produces one .prg per device family.

# App manifest.
project.manifest = manifest.xml

# Device targets (product ids; must be a subset of manifest.xml <iq:products>).
# Forerunner 245/255/265/955/965, fenix 7 (all sizes), fenix 8, epix (Gen 2),
# Venu 3.
# NOTE: verify size-variant ids against the SDK's product list when building
# (e.g. fenix 8 size variants, epix Gen 2 51mm, *music Forerunner variants).
product = forerunner245,forerunner255,forerunner265,forerunner955,forerunner965,fenix7,fenix7s,fenix7x,fenix8,epix2,venu3,venu3s

# Minimum Connect IQ API level: all targets support >= 3.2 (ActivityMonitor
# live cadence, SwitchableView, resource menus).
minSdkVersion = 3.2.0

# Developer key (free, from Garmin) — required to produce a signed .prg.
# Get one via the Connect IQ SDK Manager, then set it here (or pass it to
# the build):
# developer.key = /path/to/developer_key.der

# Output directory for the built .prg files.
# output.dir = bin
