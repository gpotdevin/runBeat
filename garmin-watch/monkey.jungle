# Build configuration for the RunBeat companion watch app (Monkey C).
# This project is NOT part of the Android Gradle build. Build it with the
# Garmin Connect IQ SDK (VS Code extension or Eclipse + SDK Manager):
# monkeyc compile + package produces one .prg per device family.

# App manifest.
project.manifest = manifest.xml

# Device targets (product ids; must be a subset of manifest.xml <iq:products>).
# Forerunner 245/255/265/955/965, fenix 7 (all sizes), fenix 8 (solar
# 47/51mm, AMOLED 43/47mm), epix (Gen 2), Venu 2 / 3. Ids verified against
# the Connect IQ SDK 9.3.0 device-reference and Garmin real device data.
product = fr245,fr255,fr265,fr955,fr965,fenix7,fenix7s,fenix7x,fenix8solar47mm,fenix8solar51mm,fenix843mm,fenix847mm,epix2,venu2,venu3,venu3s

# Minimum Connect IQ API level: all targets support >= 3.2. ViewLoop paging
# needs 3.4.0 and is guarded at runtime ("WatchUi has :ViewLoop"); a real
# fr245 at CIQ 3.3.1 takes the MainView-only fallback.
minSdkVersion = 3.2.0

# Developer key (free, from Garmin) — required to produce a signed .prg.
# Get one via the Connect IQ SDK Manager, then set it here (or pass it to
# the build):
# developer.key = /path/to/developer_key.der

# Output directory for the built .prg files.
# output.dir = bin
